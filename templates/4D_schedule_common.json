{
  "_comment": "COMMON 4D schedule template — fallback used by Time Machine + nD engine for ANY building that lacks native IFC 4D, and per-element where native 4D is incomplete. See prompts/4D_CAPTURE_AND_FALLBACK.md.",
  "version": "1.0",

  "source_priority": ["ifc_native", "template_generated"],
  "_source_priority_note": "Always prefer a real IFC programme (IfcWorkSchedule/IfcTask/IfcRelSequence + task->element links). This template only fills elements the IFC schedule does not cover (per-element fallback).",

  "calendar": {
    "project_start": "2026-01-05",
    "_project_start_note": "Anchor for purely-generated schedules. When native 4D exists, its real dates win and this is ignored.",
    "working_days": [1, 2, 3, 4, 5],
    "non_working_days": [0, 6],
    "hours_per_day": 8,
    "_calendar_note": "Region-neutral default: Mon-Fri, Sun=0..Sat=6. Override per project/region (e.g. Mon-Sat for MY/CIDB)."
  },

  "zoning": {
    "strategy": "spatial_grid",
    "_strategy_options": "none | spatial_grid | by_storey — mimics how a planner splits one trade across locations (the Hospital 'Zone A/B/C' pattern).",
    "grid_divisions": 3,
    "zone_names": ["Zone A", "Zone B", "Zone C"],
    "zone_sequence": "FINISH_START",
    "_zoning_note": "Splits each phase's elements into N location zones by plan-XY, sequenced zone-after-zone. Set strategy='none' to disable and schedule each phase as one block."
  },

  "phases": [
    {"name": "Substructure",   "sequence": 1},
    {"name": "Superstructure", "sequence": 2},
    {"name": "MEP Rough-in",   "sequence": 5},
    {"name": "Architecture",   "sequence": 6},
    {"name": "MEP Final",      "sequence": 9},
    {"name": "Finishes",       "sequence": 10}
  ],

  "ifc_class_rules": {
    "IfcFooting":               {"phase": "Substructure",   "sequence": 1,  "predecessors": [],                     "resource": "CONCRETE_GANG", "productivity": 10.0},
