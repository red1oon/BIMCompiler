    "IfcBuildingElementPart":   {"phase": "Architecture",   "sequence": 6,  "predecessors": [],                     "resource": "LABORER",       "productivity": 10.0},

    "IfcLightFixture":          {"phase": "MEP Final",      "sequence": 9,  "predecessors": ["IfcWall"],            "resource": "ELECTRICIAN",   "productivity": 20.0},
    "IfcOutlet":                {"phase": "MEP Final",      "sequence": 9,  "predecessors": ["IfcWall"],            "resource": "ELECTRICIAN",   "productivity": 25.0},
    "IfcElectricAppliance":     {"phase": "MEP Final",      "sequence": 9,  "predecessors": ["IfcWall"],            "resource": "ELECTRICIAN",   "productivity": 8.0},
    "IfcFlowTerminal":          {"phase": "MEP Final",      "sequence": 9,  "predecessors": ["IfcDuct"],            "resource": "HVAC_TECH",     "productivity": 6.0},

    "IfcCovering":              {"phase": "Finishes",       "sequence": 10, "predecessors": ["IfcLightFixture"],    "resource": "FINISHER",      "productivity": 15.0},
    "IfcFurniture":             {"phase": "Finishes",       "sequence": 11, "predecessors": ["IfcCovering"],        "resource": "FINISHER",      "productivity": 8.0},
    "IfcFurnishingElement":     {"phase": "Finishes",       "sequence": 11, "predecessors": ["IfcCovering"],        "resource": "FINISHER",      "productivity": 8.0},

    "_default":                 {"phase": "Architecture",   "sequence": 6,  "predecessors": [],                     "resource": "LABORER",       "productivity": 10.0}
  },

  "_productivity_units": "units (m, m2, m3, or count per discipline) installed per resource-crew per 8h day. Higher = faster.",

  "anchoring": {
    "_note": "Used only when native 4D is partially present. Generated elements inherit the date window of the nearest covering real task by (storey-band, phase); if none, slot proportionally across the real [project_start, project_finish]. See prompts/4D_CAPTURE_AND_FALLBACK.md §3.3.",
    "match_by": ["storey_band", "phase"],
    "uncovered_distribution": "proportional_by_zband_seq"
  }
}
