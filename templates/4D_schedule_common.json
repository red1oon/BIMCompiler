    "IfcReinforcingBar":        {"phase": "Substructure",   "sequence": 1,  "predecessors": [],                     "resource": "STEEL_ERECTOR", "productivity": 20.0},

    "IfcColumn":                {"phase": "Superstructure", "sequence": 2,  "predecessors": ["IfcFooting"],         "resource": "STEEL_ERECTOR", "productivity": 6.0},
