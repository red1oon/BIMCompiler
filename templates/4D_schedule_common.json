    "IfcSlab":                  {"phase": "Superstructure", "sequence": 4,  "predecessors": ["IfcBeam"],            "resource": "CONCRETE_GANG", "productivity": 35.0},
    "IfcMember":                {"phase": "Superstructure", "sequence": 3,  "predecessors": ["IfcColumn"],          "resource": "STEEL_ERECTOR", "productivity": 8.0},
