    "IfcWallStandardCase":      {"phase": "Architecture",   "sequence": 6,  "predecessors": ["IfcDuct", "IfcPipe"], "resource": "MASON",         "productivity": 12.0},
    "IfcCurtainWall":           {"phase": "Architecture",   "sequence": 6,  "predecessors": ["IfcSlab"],            "resource": "MASON",         "productivity": 8.0},
