<?xml version="1.0" encoding="UTF-8"?>
<!-- org.idempiere.bimootb — the BIM OOTB viewer served by iDempiere's own Jetty at /bimootb (Web-ContextPath), same origin as /ADInterface: the viewer's push needs no CORS rule.
     metadata-complete: no annotation / websocket scanning (the bundle requires org.adempiere.ui.zk for the tab; a scan found ZK's ServerPushEndPoint and failed the context). Static files only (the viewer app is copied in at build time from bim-ootb, tools/build_bundle_poc.sh); Jetty's default servlet serves them.
     bim-compiler prompts/BIM_OOTB_LEGACY_IDEMPIERE_INTEGRATION.md §8 P2. Header as org.adempiere.ui.zk's web.xml (Jetty-Environment ee8 = javaee 4.0). -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	   xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	   version="4.0" metadata-complete="true">
	<display-name>BIM OOTB viewer</display-name>
	<welcome-file-list><welcome-file>viewer/viewer.html</welcome-file></welcome-file-list>
	<mime-mapping><extension>wasm</extension><mime-type>application/wasm</mime-type></mime-mapping>
	<mime-mapping><extension>db</extension><mime-type>application/octet-stream</mime-type></mime-mapping>
	<mime-mapping><extension>mjs</extension><mime-type>text/javascript</mime-type></mime-mapping>
</web-app>
