Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: BIM OOTB for iDempiere (viewer push setup + BIM tab)
Bundle-SymbolicName: org.idempiere.bimootb
Bundle-Version: 13.1.0.qualifier
Bundle-Vendor: iDempiere Community
Bundle-RequiredExecutionEnvironment: JavaSE-17
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version>=17))"
Require-Bundle: org.adempiere.base;bundle-version="13.0.0",
 org.adempiere.ui.zk;bundle-version="13.0.0",
 org.adempiere.plugin.utils;bundle-version="13.0.0"
Import-Package: org.osgi.framework;version="1.10.0",
 org.osgi.service.component;version="1.5.0"
Service-Component: OSGI-INF/*.xml
Bundle-Activator: org.adempiere.plugin.utils.Incremental2PackActivator
Automatic-Module-Name: org.idempiere.bimootb
