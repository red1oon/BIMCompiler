   {
    "key": "CtrlL"
   },
   {
    "wait": "red1> "
   },
   {
    "line": "menu"
   },
   {
    "wait": "red1 menu> ",
    "quiet": 1.0,
    "max": 120
   }
  ]
 },
 {
