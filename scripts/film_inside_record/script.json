    "quiet": 1.5,
    "max": 240
   }
  ]
 },
 {
  "id": "co",
  "do": [
   {
    "key": "CtrlL"
   },
   {
    "wait": "red1 menu/Quote-to-Invoice (Sales)/Sales Orders/Order/80000> "
   },
   {
    "line": "do CO"
