   {
    "wait": "red1 menu/Quote-to-Invoice (Sales)/Sales Orders/Order> ",
    "quiet": 0.8,
    "max": 60
   },
   {
    "key": "ShiftTab"
   },
   {
    "wait": "red1 menu/Quote-to-Invoice (Sales)/Sales Orders> ",
